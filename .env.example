POSTGRES_DB=resolveflow
POSTGRES_USER=resolveflow
POSTGRES_PASSWORD=resolveflow
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://resolveflow:resolveflow@localhost:5432/resolveflow
TEST_DATABASE_URL=postgresql+psycopg://resolveflow:resolveflow@localhost:5432/resolveflow_test
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
JWT_SECRET=resolveflow-development-only-jwt-secret-change-before-production
JWT_ISSUER=resolveflow-api
JWT_AUDIENCE=resolveflow-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=2
JOB_RETRY_MAX_SECONDS=60
JOB_LEASE_SECONDS=90
TASK_SOFT_TIME_LIMIT_SECONDS=45
TASK_TIME_LIMIT_SECONDS=60
BROKER_VISIBILITY_TIMEOUT_SECONDS=120
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=1
LLM_MAX_OUTPUT_TOKENS=800
LLM_CONTEXT_WINDOW_TOKENS=1050000
LLM_MAX_INPUT_TOKENS=12000
LLM_RESERVED_REASONING_TOKENS=4000
LLM_CONTEXT_SAFETY_MARGIN_TOKENS=1000
OPENAI_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15
KNOWLEDGE_EMBEDDING_MAX_ATTEMPTS=3
KNOWLEDGE_EMBEDDING_RETRY_BASE_SECONDS=0.5
MCP_JWT_SECRET=resolveflow-development-only-mcp-secret-change-before-production
MCP_JWT_ISSUER=https://auth.resolveflow.local/agent-runtime
MCP_ORDER_SERVER_URL=http://127.0.0.1:8011/mcp
MCP_TOKEN_EXPIRE_SECONDS=60
MCP_TIMEOUT_SECONDS=2
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RECOVERY_SECONDS=15
# Development/test-only JSON array. Production must inject a real order source.
MCP_ORDER_FIXTURES_JSON=[]
# Restrict LangGraph checkpoint deserialization to safe built-in types.
LANGGRAPH_STRICT_MSGPACK=true
